# Copy to benchmark/minimap2/.env and edit. Loaded by minimap2_bench.sh.
# Does not override variables already set in the shell.

# Root for the datasets (data/<dataset>/...) and results (results/{runs,csvs}).
# SSD, off-repo -- never point this inside the git working tree.
MINIMAP2_BENCH_ROOT=/localdata/shay_sirek/minimap2

# Optional overrides (defaults: $MINIMAP2_BENCH_ROOT/data and $MINIMAP2_BENCH_ROOT/results)
# MINIMAP2_DATA_DIR=/localdata/shay_sirek/minimap2/data
# MINIMAP2_RESULTS_DIR=/localdata/shay_sirek/minimap2/results
