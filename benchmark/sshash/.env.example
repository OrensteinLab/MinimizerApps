# Copy to benchmark/sshash/.env and edit. Loaded by sshash_bench.sh and python -m scripts.
# Does not override variables already set in the shell.

# Root for downloads (data/<dataset>/...) and results (default: .../results).
SSHASH_BENCH_ROOT=/localdata/shay_sirek/sshash

# Optional overrides (defaults: $SSHASH_BENCH_ROOT and $SSHASH_BENCH_ROOT/results)
# SSHASH_DATA_DIR=/localdata/shay_sirek/sshash
# SSHASH_RESULTS_DIR=/localdata/shay_sirek/sshash/results
