# Local env overrides (not committed)
kraken2/.env

# Paper-eval local copy (CSVs under kraken2/tables/ are committed)
kraken2/kraken2_sup.xlsx

# KMC3 paper benchmark harness — harness itself is tracked; local data and
# outputs are not.
kmc/.env
kmc/work/
kmc/results/
kmc/**/__pycache__/
kmc/**/*.pyc
kmc/.pytest_cache/
# Downloaded / prepared FASTQ and generated file lists
kmc/data/*/
!kmc/data/*.csv

# sshash benchmark harness — harness itself is tracked; local data and
# outputs are not.
sshash/.env
sshash/.venv/
sshash/results/
sshash/**/__pycache__/
sshash/**/*.pyc
sshash/.pytest_cache/
# Downloaded eulertigs FASTA / query FASTQ (data/datasets.csv and the
# committed sanity-check query sets under data/queries/ are tracked).
sshash/data/cod/
sshash/data/kestrel/
sshash/data/human/
sshash/data/adhoc/
