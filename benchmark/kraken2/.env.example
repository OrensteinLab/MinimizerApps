# Copy to benchmark/kraken2/.env and adjust paths for your machine:
#   cp benchmark/kraken2/.env.example benchmark/kraken2/.env
#   source benchmark/kraken2/.env
#
# benchmark.env is gitignored; never commit local paths or secrets.

# Where db/, data/, and runs/ live.
export KRAKEN2_BENCHMARK_DIR="${KRAKEN2_BENCHMARK_DIR:-/path/to/kraken2-benchmark}"

# Optional overrides for GreedyMini rank tables (defaults: repo minimizers/GreedyMini/).
# export GM_FILE=/path/to/w5_k15_canonical.gm
# export MOD_GM_FILE=/path/to/w5_k6_canonical.gm

# Conda env with bioconda kraken2 (required). See environment.yml / setup.sh.
export CONDA_ENV="${CONDA_ENV:-kraken_env}"
# NCBI subsample fractions for db/standard_p10 / db/standard_p0.5:
# export SAMPLE_FRAC=0.1
# export SAMPLE_SMOKE_FRAC=0.005
# export PAIRS_PER_RUN=10000
#
# NCBI libraries (scripts/standard_installation.sh set, no hash build):
#   ./benchmark/kraken2/download_library.sh -o "$KRAKEN2_BENCHMARK_DIR"
# Classify reads (strain-exclusion + Table S5 ARGOS):
#   ./benchmark/kraken2/download_data.sh -o "$KRAKEN2_BENCHMARK_DIR"
# Strain-exclusion FASTA:
#   ./benchmark/kraken2/prepare_strex_data.sh -o "$KRAKEN2_BENCHMARK_DIR"
