# Copy to benchmark/.env and edit. Loaded by kmc3_bench.sh and python -m scripts.
# Does not override variables already set in the shell.

# Root for downloads (data/<dataset>/…) and results (default: …/results).
# Use a path outside the repo if datasets are large (multi‑TB for h_sapiens_3).
KMC3_BENCH_ROOT=/path/to/kmc-benchmark-data

# Optional overrides (defaults: $KMC3_BENCH_ROOT and $KMC3_BENCH_ROOT/results)
# KMC3_DATA_DIR=/path/to/kmc-benchmark-data
# KMC3_RESULTS_DIR=/path/to/kmc-benchmark-data/results
