# Copy to benchmark/kmc/.env and edit. Loaded by kmc3_bench.sh and python -m scripts.
# Does not override variables already set in the shell.

# Root of all generated data. Layout under it:
#   data/<dataset>/...          FASTQ downloads (multi-TB for h_sapiens_3)
#   results/runs/...            per-run outputs
#   results/csvs/*.csv          exported tables (kmc3_*.csv, density caches)
#   results/*.xlsx         exported workbook (kmc3_results.xlsx)
# Use a path outside the repo.
KMC3_BENCH_ROOT=/path/to/kmc

# Optional overrides (defaults: $KMC3_BENCH_ROOT/data and $KMC3_BENCH_ROOT/results)
# KMC3_DATA_DIR=/path/to/kmc/data
# KMC3_RESULTS_DIR=/path/to/kmc/results
