# Root-level ignores for the monorepo (each app also keeps its own .gitignore
# for app-specific build artifacts; this covers things shared across common/,
# orders/, and top-level tooling).
__pycache__/
*.pyc
.pytest_cache/

# Profiling builds (benchmark/*/experiments/profile_run.sh)
build-prof/

# Figures written by paper-export/make_figures.py (default --out)
paper-export/figures/
